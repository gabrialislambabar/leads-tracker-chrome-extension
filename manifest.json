{
    "manifest_version": 3,
    "name": "Lead Tracker — Links & Time",
    "version": "2.0.0",
    "minimum_chrome_version": "102",
    "description": "Save useful links and see how much active time you spend on each website. Everything stays on your device.",
    "icons": {
        "128": "icon.png"
    },
    "action": {
        "default_title": "Lead Tracker",
        "default_popup": "index.html",
        "default_icon": {
            "128": "icon.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "tabs",
        "storage",
        "idle",
        "alarms"
    ]
}
